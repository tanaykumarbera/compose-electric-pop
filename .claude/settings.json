{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(library/)",
      "Write(demo/)",
      "Write(docs/)",
      "Edit(library/)",
      "Edit(demo/)",
      "Edit(docs/)",
      "Bash(./gradlew *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git revert*)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(git ls-remote *)",
      "Bash(git -C *)",
      "Bash(mkdir -p *)",
      "Bash(find *)",
      "Bash(jar *)",
      "Bash(javap *)",
      "Bash(jq *)",
      "Bash(./scripts/stitch-cache.sh *)",
      "Bash(scripts/stitch-cache.sh *)",
      "Bash(./scripts/check-design-rules.sh *)",
      "Bash(scripts/check-design-rules.sh *)",
      "Bash(./scripts/verify-change.sh)",
      "mcp__stitch__list_screens",
      "mcp__stitch__get_screen",
      "mcp__plugin_github_github__*",
      "mcp__plugin_context7_context7__*",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/design-rule-posttooluse.sh"
          }
        ]
      }
    ]
  }
}
